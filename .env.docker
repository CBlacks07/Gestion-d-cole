# ============================================================
#  Gestion École — Variables d'environnement Docker
#  Copier ce fichier en ".env" et remplir les valeurs
#  cp .env.docker .env
# ============================================================

# ── Base de données ──────────────────────────────────────
DB_NAME=ECOLE
DB_USER=ecole_user
DB_PASSWORD=CHANGE_MOI_mot_de_passe_fort

# ── Sécurité (générer avec : openssl rand -base64 48) ───
JWT_SECRET=CHANGE_MOI_secret_jwt_tres_long_et_aleatoire

# ── Réseau ───────────────────────────────────────────────
# Port d'accès depuis le réseau local (80 = pas besoin de port dans l'URL)
APP_PORT=80

# Adresses autorisées (IP locale du serveur + localhost)
CORS_ORIGIN=http://192.168.1.250,http://localhost

# ── Rate limiting (valeurs par défaut recommandées) ──────
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=500
LOGIN_RATE_LIMIT_MAX=20
LOGIN_MAX_FAILED_ATTEMPTS=10
LOGIN_LOCK_DURATION_MINUTES=15
