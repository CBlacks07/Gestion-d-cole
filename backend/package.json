{
  "name": "gestion-ecole-backend",
  "version": "1.0.0",
  "description": "Backend API pour la gestion d'établissement scolaire",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node scripts/run-tests.js",
    "db:init": "psql -U gestion_user -d Ecole -f database/schema.sql",
    "db:migrate:reliability": "psql -U gestion_user -d Ecole -f database/migration_data_reliability.sql",
    "db:migrate:semesters": "node scripts/migrate-semester-periods.js",
    "db:migrate:refresh-tokens": "psql -U gestion_user -d Ecole -f database/migration_refresh_tokens.sql",
    "db:migrate:multi-ecole": "psql -U gestion_user -d Ecole -f database/migration_multi_ecole.sql",
    "create-admin": "node scripts/create-admin.js"
  },
  "dependencies": {
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-cron": "^4.2.1",
    "pdfkit": "^0.17.2",
    "pg": "^8.11.3",
    "resend": "^6.18.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "jest": "^19.0.2",
    "nodemon": "^3.0.2"
  }
}
