PORT=5001
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_NAME=ECOLE
DB_USER=postgres
DB_PASSWORD=change_me

# Minimum recommended: 32+ chars
JWT_SECRET=replace_with_a_long_random_secret
# Durée de vie de l'access token (ex: 15m, 1h, 8h)
JWT_EXPIRES_IN=15m
# Durée de vie du refresh token en jours
REFRESH_TOKEN_DAYS=7

# Comma-separated origins for frontend apps
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:3002

# API/global throttling
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=300

# Login endpoint throttling
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10

# Account lockout policy
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_DURATION_MINUTES=15

# Répertoire des fichiers de log (défaut: ./logs)
LOG_DIR=./logs
# Niveau de log (debug|info|warn|error)
LOG_LEVEL=info

# Optional (for npm run create-admin)
ADMIN_EMAIL=admin@ecole.tg
ADMIN_NOM=Admin
ADMIN_PRENOM=Systeme
ADMIN_TELEPHONE=+22800000000
ADMIN_PASSWORD=@dmin123

# Requis pour que POST /api/ecoles (signup self-service) accepte une
# nouvelle école — sans cette variable, le signup est fermé (fail closed).
# Distribuer ce code uniquement aux écoles que vous invitez.
SIGNUP_INVITE_CODE=
