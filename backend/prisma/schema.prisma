// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Modèle User pour l'authentification
model User {
  id          String   @id @default(uuid())
  nom         String
  prenom      String
  email       String   @unique
  motDePasse  String
  role        Role     @default(SECRETAIRE)
  telephone   String?
  actif       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  absencesEnregistrees Absence[]
  paiementsEnregistres Paiement[]

  @@map("users")
}

// Modèle Eleve
model Eleve {
  id                  String   @id @default(uuid())
  matricule           String   @unique
  nom                 String
  prenom              String
  dateNaissance       DateTime
  lieuNaissance       String
  sexe                Sexe
  classeId            String?
  photo               String?

  // Informations tuteur (JSON)
  tuteurNom           String
  tuteurPrenom        String
  tuteurTelephone     String
  tuteurEmail         String?
  tuteurProfession    String?
  tuteurAdresse       String?

  // Informations médicales
  groupeSanguin       String?
  allergies           String[] // Array de strings
  maladiesChroniques  String[] // Array de strings

  statut              StatutEleve @default(ACTIF)
  anneeScolaire       String
  dateInscription     DateTime    @default(now())
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  // Relations
  classe    Classe?    @relation(fields: [classeId], references: [id])
  notes     Note[]
  absences  Absence[]
  paiements Paiement[]

  @@index([classeId])
  @@index([statut])
  @@index([anneeScolaire])
  @@map("eleves")
}

// Modèle Enseignant
model Enseignant {
  id              String   @id @default(uuid())
  matricule       String   @unique
  nom             String
  prenom          String
  dateNaissance   DateTime
  sexe            Sexe
  telephone       String
  email           String?
  adresse         String?
  photo           String?

  // Diplômes stockés en JSON
  diplomes        Json?

  dateRecrutement DateTime
  statut          StatutEnseignant @default(ACTIF)
  typeContrat     TypeContrat      @default(PERMANENT)
  salaire         Decimal?         @db.Decimal(10, 2)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Relations
  classesCommeResponsable Classe[]
  specialites             EnseignantMatiere[]
  notes                   Note[]

  @@index([statut])
  @@map("enseignants")
}

// Modèle Classe
model Classe {
  id                      String   @id @default(uuid())
  nom                     String
  niveau                  Niveau
  cycle                   Cycle
  section                 String?
  anneeScolaire           String
  enseignantPrincipalId   String?
  effectifMax             Int      @default(50)
  salle                   String?

  // Frais de scolarité
  montantInscription      Decimal  @default(0) @db.Decimal(10, 2)
  montantMensuel          Decimal  @default(0) @db.Decimal(10, 2)
  devise                  String   @default("XOF")

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  // Relations
  enseignantPrincipal Enseignant? @relation(fields: [enseignantPrincipalId], references: [id])
  eleves              Eleve[]
  notes               Note[]
  absences            Absence[]

  @@index([cycle])
  @@index([anneeScolaire])
  @@map("classes")
}

// Modèle Matiere
model Matiere {
  id          String   @id @default(uuid())
  nom         String
  code        String   @unique
  description String?
  coefficient Int      @default(1)
  niveaux     Niveau[] // Array d'enums
  cycles      Cycle[]  // Array d'enums
  couleur     String   @default("#3B82F6")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  enseignants EnseignantMatiere[]
  notes       Note[]
  absences    Absence[]

  @@map("matieres")
}

// Table de liaison Enseignant-Matiere
model EnseignantMatiere {
  id            String   @id @default(uuid())
  enseignantId  String
  matiereId     String
  assignedAt    DateTime @default(now())

  enseignant Enseignant @relation(fields: [enseignantId], references: [id], onDelete: Cascade)
  matiere    Matiere    @relation(fields: [matiereId], references: [id], onDelete: Cascade)

  @@unique([enseignantId, matiereId])
  @@map("enseignant_matieres")
}

// Modèle Note
model Note {
  id              String          @id @default(uuid())
  eleveId         String
  matiereId       String
  classeId        String
  enseignantId    String?
  typeEvaluation  TypeEvaluation
  periode         Periode
  anneeScolaire   String
  note            Decimal         @db.Decimal(5, 2)
  noteMax         Decimal         @default(20) @db.Decimal(5, 2)
  coefficient     Int             @default(1)
  commentaire     String?
  dateEvaluation  DateTime        @default(now())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relations
  eleve      Eleve       @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  matiere    Matiere     @relation(fields: [matiereId], references: [id])
  classe     Classe      @relation(fields: [classeId], references: [id])
  enseignant Enseignant? @relation(fields: [enseignantId], references: [id])

  @@index([eleveId])
  @@index([classeId])
  @@index([matiereId])
  @@index([periode])
  @@index([anneeScolaire])
  @@map("notes")
}

// Modèle Absence
model Absence {
  id              String        @id @default(uuid())
  eleveId         String
  classeId        String
  date            DateTime
  matiereId       String?
  periode         PeriodeJour   @default(TOUTE_JOURNEE)
  justifiee       Boolean       @default(false)
  motif           String?
  justificatif    String?
  anneeScolaire   String
  enregistreParId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  eleve         Eleve   @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  classe        Classe  @relation(fields: [classeId], references: [id])
  matiere       Matiere? @relation(fields: [matiereId], references: [id])
  enregistrePar User?   @relation(fields: [enregistreParId], references: [id])

  @@index([eleveId])
  @@index([classeId])
  @@index([date])
  @@index([anneeScolaire])
  @@map("absences")
}

// Modèle Paiement
model Paiement {
  id              String        @id @default(uuid())
  eleveId         String
  typePaiement    TypePaiement
  montant         Decimal       @db.Decimal(10, 2)
  devise          String        @default("XOF")
  datePaiement    DateTime      @default(now())
  moisConcerne    String?
  anneeScolaire   String
  modePaiement    ModePaiement  @default(ESPECES)
  numeroPiece     String?
  statut          StatutPaiement @default(VALIDE)
  remarques       String?
  enregistreParId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  eleve         Eleve @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  enregistrePar User? @relation(fields: [enregistreParId], references: [id])

  @@index([eleveId])
  @@index([typePaiement])
  @@index([anneeScolaire])
  @@index([statut])
  @@map("paiements")
}

// Enums
enum Role {
  ADMIN
  DIRECTEUR
  ENSEIGNANT
  SECRETAIRE
}

enum Sexe {
  M
  F
}

enum StatutEleve {
  ACTIF
  INACTIF
  TRANSFERE
  DIPLOME
}

enum StatutEnseignant {
  ACTIF
  CONGE
  SUSPENDU
  DEMISSIONNE
}

enum TypeContrat {
  PERMANENT
  VACATAIRE
  CONTRACTUEL
}

enum Cycle {
  PRIMAIRE
  COLLEGE
  LYCEE
}

enum Niveau {
  CP1
  CP2
  CE1
  CE2
  CM1
  CM2
  SIXIEME
  CINQUIEME
  QUATRIEME
  TROISIEME
  SECONDE
  PREMIERE
  TERMINALE
}

enum TypeEvaluation {
  DEVOIR
  COMPOSITION
  INTERROGATION
  TP
  EXAMEN
}

enum Periode {
  PREMIER_TRIMESTRE
  DEUXIEME_TRIMESTRE
  TROISIEME_TRIMESTRE
}

enum PeriodeJour {
  MATIN
  APRES_MIDI
  TOUTE_JOURNEE
}

enum TypePaiement {
  INSCRIPTION
  SCOLARITE
  CANTINE
  TRANSPORT
  UNIFORME
  AUTRES
}

enum ModePaiement {
  ESPECES
  CHEQUE
  VIREMENT
  MOBILE_MONEY
}

enum StatutPaiement {
  VALIDE
  EN_ATTENTE
  ANNULE
}
